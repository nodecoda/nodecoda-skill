@language nodecoda/1
@mode workflow

// parallel for:并发处理数组 + 收集结果
// 展示 parallel for(concurrency / on_error)、yield

const MODEL = "openai_api_compatible/gpt-5.4";

function main(string csv) -> string[] {
    let items = split(csv, ",");

    // 并发 3 路处理,单项失败跳过继续
    let results = parallel for (item in items, concurrency: 3, on_error: continue) {
        let r = llm(MODEL, {
            "messages": [{ "role": "user", "content": `分析并总结:${item}` }]
        });
        yield r.text;
    };

    return results;
}
