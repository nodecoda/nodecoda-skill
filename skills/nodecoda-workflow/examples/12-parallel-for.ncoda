@language nodecoda/1
@mode workflow

// parallel for:并发处理数组 + 收集结果
// 展示 parallel for(concurrency / on_error)、yield
// (on_error 只接受 terminate | keep_null | remove_failed;见 gotchas G12)

const MODEL = "openai_api_compatible/gpt-5.4";

function main(string csv) -> string[] {
    let items = split(csv, ",");

    // 并发 3 路处理,失败项从结果中剔除,其余继续
    let results = parallel for (item in items, concurrency: 3, on_error: remove_failed) {
        let r = llm(MODEL, {
            "messages": [{ "role": "user", "content": `分析并总结:${item}` }]
        });
        yield r.text;
    };

    return results;
}
