@language nodecoda/1
@mode workflow

// 错误处理:attempt 捕获物理失败 + with retry / timeout 操作策略
// 展示 attempt/success/failure、retry(max, interval)、timeout(duration)
// (另有 default(expr) 兜底策略,见 language-reference §11)

const MODEL = "openai_api_compatible/gpt-5.4";

function main(string query) -> string {
    // 操作策略可叠加:retry(max, interval) + timeout(duration)
    let response = llm(MODEL, {
        "messages": [{ "role": "user", "content": query }]
    }) with retry(max: 3, interval: 1s), timeout(30s);

    // attempt 捕获操作的物理失败(网络错误、超时等)
    attempt http("GET", "https://api.example.com/quote", {
        "headers": { "Accept": "application/json" }
    }) as page {
        success {
            return `模型:${response.text}\n行情:${page.body}`;
        }
        failure(error) {
            return `模型:${response.text}\n(行情获取失败:${error.error_message})`;
        }
    }
}
