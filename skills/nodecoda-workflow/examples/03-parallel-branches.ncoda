@language nodecoda/1
@mode workflow

// 命名并行:同时跑两个 LLM,收集结果后做对比
// 适合 "双盲评估" / "多视角合成" 场景
const MODEL = "openai_api_compatible/gpt-5.4";

function main(string topic) -> string {
    let results = parallel {
        optimistic: {
            let r = llm(MODEL, {
                "messages": [{ "role": "user", "content": `用乐观视角分析:${topic}` }]
            });
            yield r.text;
        }
        critical: {
            let r = llm(MODEL, {
                "messages": [{ "role": "user", "content": `用批判视角分析:${topic}` }]
            });
            yield r.text;
        }
    };

    let synthesis = llm(MODEL, {
        "messages": [{
            "role": "user",
            "content": `乐观视角:\n${results.optimistic}\n\n批判视角:\n${results.critical}\n\n请综合给出平衡结论:`
        }]
    });
    return synthesis.text;
}
