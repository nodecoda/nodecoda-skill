@language nodecoda/1
@mode workflow

// 知识库检索 + 文档提取 + RAG 问答
// 展示 knowledge()、extract_text() + file<> 类型、std.v1.rag_answer()

const MODEL = "openai_api_compatible/gpt-5.4";

function main(string query, file<document; .pdf, .txt> doc) -> string {
    // 1) 文档文本提取:file<> 变量没有 .text 字段,必须用 extract_text(实证 G2/G3)
    let extracted = extract_text(doc);

    if (extracted.text == "") {
        // 空文档:直接用标准库 RAG 问答(dataset-id 与 model 必须为字面量)
        return std.v1.rag_answer(query, "ds-001", "openai/gpt-4o");
    }

    // 2) 知识库检索:多数据集用逗号分隔
    let docs = knowledge("ds-001,ds-002", query, {});

    // 3) LLM 结合文档与检索片段回答
    let reply = llm(MODEL, {
        "messages": [{
            "role": "user",
            "content": `用户问题:${query}\n上传文档:${extracted.text}\n知识库片段:${docs.result}\n请综合回答:`
        }]
    });
    return reply.text;
}
