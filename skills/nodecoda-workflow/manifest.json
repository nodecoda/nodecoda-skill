{
  "name": "nodecoda-workflow",
  "version": "0.2.9",
  "description": "Author, validate, and build Dify workflows via NodeCoda MCP. Use when the user wants to author .ncoda source, call build_dify_workflow, interpret diagnostics, or iterate on Dify workflow generation. Live: codex + public deployment wired.",
  "platforms": [
    "claude-code",
    "codex",
    "gemini-cli",
    "cursor"
  ],
  "min_nodecoda": "1.0.0",
  "target_profile": "dify-1.16-graphon-0.6",
  "language_identity": "nodecoda/1",
  "mcp_tools": [
    "build_dify_workflow",
    "get_workflow_build",
    "cancel_workflow_build"
  ],
  "entry": "SKILL.md",
  "references": [
    "references/mcp-contract.md",
    "references/source-generation.md",
    "references/language-reference.md",
    "references/public-service.md",
    "references/diagnostics.md",
    "references/target-capabilities.md",
    "references/iteration-loop.md",
    "references/failure-modes.md"
  ],
  "examples": [
    "examples/01-hello-workflow.ncoda",
    "examples/02-with-llm.ncoda",
    "examples/03-parallel-branches.ncoda",
    "examples/04-code-node.ncoda"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/nodecoda/nodecoda-skill",
  "repository": {
    "type": "git",
    "url": "https://github.com/nodecoda/nodecoda-skill.git"
  }
}
